        <package android:name="com.google.android.marvin.talkback" />
    </queries>
    <application android:label="aria-labelledby 테스트" android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
